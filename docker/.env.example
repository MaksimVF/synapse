


# Synapse configuration
SYNAPSE_SERVER_NAME=your.domain.com
SYNAPSE_REPORT_STATS=no
SYNAPSE_TURN_SECRET=your-turn-secret

# PostgreSQL configuration (external)
POSTGRES_HOST=your.postgres.host
POSTGRES_PORT=5432
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=synapse

# S3 configuration
S3_BUCKET=your-s3-bucket-name
S3_REGION=your-aws-region
# Optional: specify credentials or use AWS default credential chain
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Telegram Bridge
MAUTRIX_TELEGRAM_API_ID=your-telegram-api-id
MAUTRIX_TELEGRAM_API_HASH=your-telegram-api-hash
MAUTRIX_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
MAUTRIX_TELEGRAM_APP_SERVICE_TOKEN=your-telegram-as-token

# WhatsApp Bridge
MAUTRIX_WHATSAPP_APP_SERVICE_TOKEN=your-whatsapp-as-token

# LiveKit
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret


