

# Dockerfile for Synapse with media optimization features

FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /synapse/requirements.txt
WORKDIR /synapse
RUN pip install --no-cache-dir -r requirements.txt

# Install Pillow with JPEG support
RUN pip install --no-cache-dir pillow

# Copy Synapse source code
COPY . /synapse

# Set up data directory
RUN mkdir -p /data
WORKDIR /synapse

# Set environment variables
ENV SYNAPSE_SERVER_NAME=localhost
ENV SYNAPSE_REPORT_STATS=no

# Expose the default port
EXPOSE 8008

# Set the entrypoint
ENTRYPOINT ["python", "-m", "synapse.app.homeserver"]

# Default command
CMD ["--config-path", "/data/homeserver.yaml"]

